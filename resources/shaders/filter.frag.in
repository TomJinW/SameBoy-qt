#version 440
// Adapted from SameBoy/Shaders/MasterShader.fsh (Expat license).
// The filter body below is upstream's unmodified GLSL implementation.
layout(location=0) in vec2 uv;
layout(location=0) out vec4 frag_color;
layout(binding=1) uniform sampler2D image;
layout(binding=2) uniform sampler2D previous_image;
layout(std140,binding=0) uniform Params {
    mat4 mvp;
    vec2 output_resolution;
    int frame_blending_mode;
    int reserved;
};
#define equal(x,y) ((x)==(y))
#define inequal(x,y) ((x)!=(y))
#define STATIC
#define GAMMA 2.2
vec4 _texture(sampler2D t, vec2 pos) { return pow(texture(t,pos),vec4(GAMMA)); }
vec4 texture_relative(sampler2D t, vec2 pos, vec2 offset) {
    vec2 input_resolution=textureSize(t,0);
    return _texture(t,(floor(pos*input_resolution)+offset+vec2(0.5))/input_resolution);
}
#define texture _texture
@FILTER_SOURCE@
void main()
{
    vec2 position=uv;
    vec2 input_resolution=textureSize(image,0);
    vec4 color=scale(image,position,input_resolution,output_resolution);
    if(frame_blending_mode!=0) {
        float ratio=0.5;
        if(frame_blending_mode>=2) {
            bool even=(int(position.y*input_resolution.y)&1)==0;
            if(frame_blending_mode==3)even=!even;
            ratio=even?1.0/3.0:2.0/3.0;
        }
        color=mix(color,scale(previous_image,position,input_resolution,output_resolution),ratio);
    }
    frag_color=pow(max(color,vec4(0)),vec4(1.0/GAMMA));
}
